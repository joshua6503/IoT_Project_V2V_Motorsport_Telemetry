    "format": "<template>\n  <div v-if=\"msg && msg.payload && msg.payload.activa\" class=\"v2v-banner\">\n    ⚠ ALERTA CRÍTICA — {{ msg.payload.texto }}\n  </div>\n  <div v-else class=\"v2v-ok\">Sin alertas críticas activas</div>\n</template>\n<style>\n.v2v-banner { background:#c62828; color:#fff; font-weight:700; font-size:20px; padding:14px 16px; border-radius:6px; text-align:center; animation: v2vblink 1s infinite; }\n.v2v-ok { background:#e8f5e9; color:#1b5e20; padding:8px 12px; border-radius:6px; text-align:center; }\n@keyframes v2vblink { 50% { background:#e53935; } }\n</style>",
