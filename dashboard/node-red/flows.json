  {
    "id": "v2v_alerta",
    "type": "function",
    "z": "v2v_tab",
    "name": "Registro de alertas",
    "func": "// Registro de alertas (últimas 50, sin duplicados por node_id+seq) y estado del banner rojo.\nconst BANNER_SEG = 10;   // el banner rojo dura 10 s desde la última alerta crítica\nconst TIPOS = { manual: 'Manual', hard_brake: 'Frenado fuerte', obstacle: 'Obstáculo', overtemp: 'Sobretemperatura' };\nconst SEV = { info: 'Info', warning: 'Advertencia', critical: 'Crítica' };\nconst p = msg.payload;\nconst clave = p.node_id + ':' + p.seq + ':' + p.alert_type;\nlet vistos = flow.get('alertKeys') || [];\nif (vistos.includes(clave)) return null;          // reentrega QoS 1\nvistos.push(clave); if (vistos.length > 200) vistos.shift();\nflow.set('alertKeys', vistos);\n\nconst lista = flow.get('alertas') || [];\nconst hora = new Date(msg.t).toLocaleTimeString('es-MX', { hour12: false });\nlista.unshift({ 'Hora': hora, 'Nodo': p.node_id, 'Tipo': TIPOS[p.alert_type], 'Severidad': SEV[p.severity] });\nif (lista.length > 50) lista.length = 50;\nflow.set('alertas', lista);\nif (p.severity === 'critical') {\n    flow.set('critica', { hasta: msg.t + BANNER_SEG * 1000, texto: (TIPOS[p.alert_type]) + ' en ' + p.node_id });\n}\nreturn { payload: lista };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 240,
    "wires": [
      [
        "tbl_alertas"
      ]
    ]
  },
