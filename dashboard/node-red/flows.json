  {
    "id": "v2v_tlm",
    "type": "function",
    "z": "v2v_tab",
    "name": "Telemetría → widgets",
    "func": "// Salidas: 1-3 rw612-a (freno, temp, dist), 4-6 esp32-b (freno, temp, dist), 7-9 gráficas (freno, temp, dist)\nconst p = msg.payload, n = msg.node_id;\nconst base = (n === 'rw612-a') ? 0 : 3;\nconst out = [null, null, null, null, null, null, null, null, null];\nconst SEG_DIST = [{ from: 0, color: '#d32f2f' }, { from: 30, color: '#f9a825' }, { from: 100, color: '#2e7d32' }];\nconst SEG_NONE = [{ from: 0, color: '#9e9e9e' }];\nconst SEG_TEMP = [{ from: 0, color: '#2e7d32' }, { from: 70, color: '#f9a825' }, { from: 85, color: '#d32f2f' }];\n\nif (typeof p.brake_pct === 'number') {\n    out[base] = { payload: p.brake_pct };\n    out[6] = { topic: n, payload: p.brake_pct };\n}\nif (p.temp_c !== undefined) {\n    if (p.temp_c === null) {\n        out[base + 1] = { payload: 0, ui_update: { label: 'Temperatura · sin dato', segments: SEG_NONE } };\n    } else {\n        out[base + 1] = { payload: p.temp_c, ui_update: { label: 'Temperatura', segments: SEG_TEMP } };\n        out[7] = { topic: n, payload: p.temp_c };\n    }\n}\nif (p.distance_cm !== undefined) {\n    if (p.distance_cm === null) {\n        out[base + 2] = { payload: 0, ui_update: { label: 'Distancia · sin eco', segments: SEG_NONE } };\n    } else {\n        out[base + 2] = { payload: p.distance_cm, ui_update: { label: 'Distancia', segments: SEG_DIST } };\n        out[8] = { topic: n, payload: p.distance_cm };\n    }\n}\nreturn out;",
    "outputs": 9,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 620,
    "y": 100,
    "wires": [
      [
        "g_rw_brake"
      ],
      [
        "g_rw_temp"
      ],
      [
        "g_rw_dist"
      ],
      [
        "g_es_brake"
      ],
      [
        "g_es_temp"
      ],
