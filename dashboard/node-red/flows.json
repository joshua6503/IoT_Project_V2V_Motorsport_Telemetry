  {
    "id": "v2v_validar",
    "type": "function",
    "z": "v2v_tab",
    "name": "Validar mensaje",
    "func": "// Valida y descarta mensajes mal formados sin romper el flujo.\nconst NODOS = ['rw612-a', 'esp32-b'];\nconst ALERTAS = ['manual', 'hard_brake', 'obstacle', 'overtemp'];\nconst SEVERIDADES = ['info', 'warning', 'critical'];\nconst isUint = (v, max) => Number.isInteger(v) && v >= 0 && v <= max;\nconst isNumOrNull = (v) => v === null || (typeof v === 'number' && isFinite(v));\nconst isPct = (v) => typeof v === 'number' && isFinite(v) && v >= 0 && v <= 100;\n\nfunction descartar(motivo) {\n    const n = (context.get('ignorados') || 0) + 1;\n    context.set('ignorados', n);\n    node.status({ fill: 'yellow', shape: 'ring', text: 'ignorados: ' + n + ' (' + motivo + ')' });\n    const ahora = Date.now();\n    if (ahora - (context.get('ultimoAviso') || 0) > 10000) {\n        context.set('ultimoAviso', ahora);\n        node.warn('mensaje ignorado (' + motivo + ') en ' + msg.topic);\n    }\n    return null;\n}\n\ntry {\n    const partes = String(msg.topic).split('/');\n    if (partes.length !== 3 || partes[0] !== 'v2v') return descartar('tópico');\n    const nodo = partes[1], hoja = partes[2];\n    if (!NODOS.includes(nodo)) return null;           // otros nodos (p. ej. sim-01) no se muestran\n    let p;\n    try { p = JSON.parse(String(msg.payload)); } catch (e) { return descartar('JSON'); }\n    if (p === null || typeof p !== 'object' || Array.isArray(p)) return descartar('no es objeto');\n    if (p.node_id !== nodo) return descartar('node_id');\n\n    const ahora = Date.now();\n    const seen = flow.get('seen') || {};\n    const salida = { topic: nodo, node_id: nodo, t: ahora };\n\n    if (hoja === 'telemetry') {\n        if (!isUint(p.ts_ms, 4294967295) || !isUint(p.seq, 4294967295)) return descartar('ts_ms/seq');\n        if (p.brake_pct !== undefined && !isPct(p.brake_pct)) return descartar('brake_pct');\n        if (p.tps_pct !== undefined && !isPct(p.tps_pct)) return descartar('tps_pct');\n        if (p.temp_c !== undefined && !isNumOrNull(p.temp_c)) return descartar('temp_c');\n        if (p.distance_cm !== undefined && !isNumOrNull(p.distance_cm)) return descartar('distance_cm');\n        seen[nodo] = ahora;\n        flow.set('seen', seen);\n        salida.payload = p;\n        return [salida, null];\n    }\n    if (hoja === 'alert') {\n        if (!ALERTAS.includes(p.alert_type) || !SEVERIDADES.includes(p.severity)) return descartar('alerta');\n        if (!isUint(p.ts_ms, 4294967295) || !isUint(p.seq, 65535)) return descartar('ts_ms/seq');\n        seen[nodo] = ahora;\n        flow.set('seen', seen);\n        salida.payload = p;\n        return [null, salida];\n    }\n    if (hoja === 'status') {\n        if (p.state !== 'online' && p.state !== 'offline') return descartar('state');\n        const online = flow.get('online') || {};\n        online[nodo] = p.state;\n        flow.set('online', online);\n        return null;\n    }\n    return null;\n} catch (e) {\n    return descartar('error');\n}",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 350,
    "y": 130,
    "wires": [
      [
        "v2v_tlm"
      ],
      [
        "v2v_alerta"
      ]
    ]
