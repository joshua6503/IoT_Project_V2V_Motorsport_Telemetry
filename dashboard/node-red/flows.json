  {
    "id": "v2v_estado",
    "type": "function",
    "z": "v2v_tab",
    "name": "Estado de nodos y banner",
    "func": "// Cada segundo: estado de cada nodo (retenido) + tiempo desde el último mensaje, y banner crítico.\nconst seen = flow.get('seen') || {};\nconst online = flow.get('online') || {};\nconst ahora = Date.now();\nfunction tarjeta(n) {\n    const t = seen[n], st = online[n];\n    const hace = t ? Math.max(0, Math.round((ahora - t) / 1000)) : null;\n    const detalle = hace === null ? 'sin mensajes todavía' : 'último mensaje hace ' + hace + ' s';\n    if (st === 'offline') return { estado: 'Fuera de línea', clase: 'off', detalle };\n    if (st === 'online') return hace !== null && hace > 5 ? { estado: 'En línea · sin datos recientes', clase: 'warn', detalle }\n                                                         : { estado: 'En línea', clase: 'on', detalle };\n    return { estado: hace !== null && hace <= 5 ? 'En línea (sin status)' : 'Desconocido', clase: hace !== null && hace <= 5 ? 'warn' : 'unk', detalle };\n}\nconst c = flow.get('critica');\nconst activa = !!c && c.hasta > ahora;\nreturn [{ payload: tarjeta('rw612-a') }, { payload: tarjeta('esp32-b') }, { payload: { activa, texto: activa ? c.texto : '' } }];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
