{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:v2v-motorsport-telemetry:payload",
  "title": "V2V Motorsport Telemetry MQTT payloads",
  "description": "Payloads published on v2v/{node_id}/telemetry, /alert and /status, and commands sent to v2v/{node_id}/cmd or v2v/all/cmd. See interfaces/mqtt-topics.md. Telemetry: only node_id, ts_ms and seq are required; every sensor field is optional.",
  "oneOf": [
    {
      "$ref": "#/$defs/telemetry"
    },
    {
      "$ref": "#/$defs/alert"
    },
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/cmd"
    }
  ],
  "$defs": {
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,32}$",
      "description": "Node identifier, same value as in the topic."
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "description": "Sender uptime in milliseconds (uint32, wraps). Time base TBD."
    },
    "alert_type": {
      "enum": [
        "manual",
        "hard_brake",
        "obstacle",
        "overtemp"
      ],
      "description": "Maps 1:1 to v2v_alert_type_t in interfaces/c/v2v_protocol.h."
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "description": "Maps 1:1 to v2v_severity_t in interfaces/c/v2v_protocol.h."
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "ts_ms",
        "seq"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "ts_ms": {
          "$ref": "#/$defs/ts_ms"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "brake_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Brake pedal position/pressure, percent."
        },
        "tps_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Throttle position, percent."
        },
        "temp_c": {
          "type": [
            "number",
            "null"
          ],
          "description": "null on a temperature sensor fault."
        },
        "distance_cm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "null when the distance sensor reports no echo / fault."
        },
        "sensor_ok": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "description": "Bitmask of valid sensors: bit0 distance, bit1 temperature, bit2 brake (ALERT_SENSOR_* in firmware/common/include/alert_logic.h)."
        },
        "speed_kmh": {
          "type": "number",
          "minimum": 0
        },
        "accel_g": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        }
      }
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "ts_ms",
        "seq",
        "alert_type",
        "severity"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "ts_ms": {
          "$ref": "#/$defs/ts_ms"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535,
          "description": "Same counter as v2v_packet_t.seq (uint16)."
        },
        "alert_type": {
          "$ref": "#/$defs/alert_type"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "state"
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/node_id"
        },
        "state": {
          "enum": [
            "online",
            "offline"
          ]
        }
      }
    },
    "cmd_alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cmd",
        "seq",
        "origin",
        "alert_type",
        "severity"
      ],
      "properties": {
        "cmd": {
          "const": "alert"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "Sender command counter (uint32). Nodes dedupe by (origin, seq)."
        },
        "origin": {
          "$ref": "#/$defs/node_id",
          "description": "Who sent the command; \"dashboard\" today."
        },
        "alert_type": {
          "$ref": "#/$defs/alert_type"
        },
        "severity": {
          "$ref": "#/$defs/severity"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 10000,
          "default": 3000,
          "description": "How long the node drives the actuator pattern; 3000 when absent."
        },
        "source_node": {
          "allOf": [
            {
              "$ref": "#/$defs/node_id"
            },
            {
              "not": {
                "const": "all"
              }
            }
          ],
          "description": "Set when the dashboard relays another node's alert (DEC-014)."
        }
      }
    },
    "cmd_clear": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cmd",
        "seq",
        "origin"
      ],
      "properties": {
        "cmd": {
          "const": "clear"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "origin": {
          "$ref": "#/$defs/node_id"
        }
      }
    },
    "cmd": {
      "description": "Command to a node: v2v/{node_id}/cmd, or v2v/all/cmd for every node (\"all\" is a reserved node_id).",
      "oneOf": [
        {
          "$ref": "#/$defs/cmd_alert"
        },
        {
          "$ref": "#/$defs/cmd_clear"
        }
      ]
    }
  }
}
